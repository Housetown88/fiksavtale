// Standardskjema (PostgreSQL / Neon).
// Vercel og `prisma generate` uten --schema bruker denne filen.
// Lokalt med file:./dev.db: se prisma/schema.sqlite.prisma.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum JobStatus {
  OPEN
  OFFER_ACCEPTED
  BOOKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum OfferStatus {
  PENDING
  WITHDRAWN
  ACCEPTED
  REJECTED
  EXPIRED
}

enum BookingStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum ExtraStatus {
  PROPOSED
  APPROVED
  REJECTED
  PAID
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  name         String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerProfile CustomerProfile?
  providerProfile ProviderProfile?
  sessions        Session[]
  jobs            Job[]            @relation("CustomerJobs")
  offers          Offer[]
  conversationsAsCustomer Conversation[] @relation("CustomerConversations")
  conversationsAsProvider Conversation[] @relation("ProviderConversations")
  messages        Message[]
  bookingsAsCustomer Booking[] @relation("CustomerBookings")
  bookingsAsProvider Booking[] @relation("ProviderBookings")
  reviewsGiven    Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
  reportsFiled    Report[] @relation("ReportsFiled")
  reportsAbout    Report[] @relation("ReportsAbout")
  auditLogs       AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CustomerProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressLine String?
  postalCode  String?
  city        String?
  area        String?
}

model ProviderProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String
  orgNumber     String
  orgVerified   Boolean @default(false)
  about         String?
  serviceAreas  String?
  invoiceEmail  String?
}

model Job {
  id          String    @id @default(cuid())
  customerId  String
  customer    User      @relation("CustomerJobs", fields: [customerId], references: [id])
  title       String
  description String
  category    String
  area        String
  postalCode  String?
  addressLine String?
  budgetMinOre Int?
  budgetMaxOre Int?
  status      JobStatus @default(OPEN)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  offers        Offer[]
  conversations Conversation[]
  booking       Booking?
  reports       Report[]
  images        JobImage[]
}

model JobImage {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  mimeType  String
  width     Int
  height    Int
  sizeBytes Int
  data      Bytes
  thumb     Bytes
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([jobId, sortOrder])
}

model Offer {
  id         String      @id @default(cuid())
  jobId      String
  job        Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  providerId String
  provider   User        @relation(fields: [providerId], references: [id])
  amountOre  Int
  message    String
  status     OfferStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  conversation Conversation?
  booking      Booking?
}

model Conversation {
  id         String    @id @default(cuid())
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  offerId    String?   @unique
  offer      Offer?    @relation(fields: [offerId], references: [id])
  customerId String
  customer   User      @relation("CustomerConversations", fields: [customerId], references: [id])
  providerId String
  provider   User      @relation("ProviderConversations", fields: [providerId], references: [id])
  createdAt  DateTime  @default(now())

  messages Message[]

  @@unique([jobId, providerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())
}

model Booking {
  id                String        @id @default(cuid())
  jobId             String        @unique
  job               Job           @relation(fields: [jobId], references: [id])
  offerId           String        @unique
  offer             Offer         @relation(fields: [offerId], references: [id])
  customerId        String
  customer          User          @relation("CustomerBookings", fields: [customerId], references: [id])
  providerId        String
  provider          User          @relation("ProviderBookings", fields: [providerId], references: [id])
  amountOre         Int
  platformFeeOre    Int
  providerPayoutOre Int
  platformFeeBps    Int
  status            BookingStatus @default(PENDING_PAYMENT)
  contactUnlockedAt DateTime?
  workStartedAt     DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  payments     Payment[]
  review       Review?
  extras       ExtraCharge[]
}

model Payment {
  id               String        @id @default(cuid())
  bookingId        String
  booking          Booking       @relation(fields: [bookingId], references: [id])
  paymentIntentId  String
  eventId          String        @unique
  amountOre        Int
  status           PaymentStatus
  rawPayload       String
  createdAt        DateTime      @default(now())

  @@index([paymentIntentId])
}

model PaymentIntent {
  id        String        @id @default(cuid())
  bookingId String
  amountOre Int
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
}

model ExtraCharge {
  id          String      @id @default(cuid())
  bookingId   String
  booking     Booking     @relation(fields: [bookingId], references: [id])
  title       String
  amountOre   Int
  status      ExtraStatus @default(PROPOSED)
  createdAt   DateTime    @default(now())
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  authorId   String
  author     User     @relation("ReviewsGiven", fields: [authorId], references: [id])
  targetId   String
  target     User     @relation("ReviewsReceived", fields: [targetId], references: [id])
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  reporter     User         @relation("ReportsFiled", fields: [reporterId], references: [id])
  targetUserId String?
  targetUser   User?        @relation("ReportsAbout", fields: [targetUserId], references: [id])
  targetJobId  String?
  targetJob    Job?         @relation(fields: [targetJobId], references: [id])
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  details    String?
  createdAt  DateTime @default(now())
}

model PlatformSettings {
  id              String @id @default("default")
  platformFeeBps  Int    @default(1000)
  updatedAt       DateTime @updatedAt
}
