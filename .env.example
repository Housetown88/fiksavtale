# Lokal SQLite (npm run dev)
DATABASE_URL="file:./dev.db"

# Vercel / preview: Neon Postgres ELLER Turso/libSQL — ikke en SQLite-fil
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# DATABASE_URL="libsql://DB-ORG.turso.io"
# TURSO_AUTH_TOKEN=""

# Økt — AUTH_SECRET er alias for SESSION_SECRET
SESSION_SECRET="bytt-denne-til-en-lang-tilfeldig-streng-i-produksjon"
# AUTH_SECRET=""

DEMO_WEBHOOK_SECRET="demo-webhook-hemmelighet-kun-for-prototype"
PLATFORM_FEE_BPS="1000"

# Sett til 1 på Vercel preview for å så DEMO-data første gang tabellene er tomme.
# Risiko: kan lage demo-kontoer i et miljø som skulle vært tomt. Aldri på ekte produksjon.
# SEED_DEMO="1"

# Tøm og så på nytt (farlig mot delt database)
# SEED_RESET="1"

# Vis delt DEMO-passord på /logg-inn. Standard AV i produksjon. Aldri på ekte prod med ekte brukere.
# ALLOW_DEMO_HINTS="1"
# DEMO="1"

# Tillat innlogging med admin@demo.jobbenmin.no (svakt delt passord). Standard AV i produksjon.
# ADMIN_DEMO_ALLOWED="1"

# Opprett én sterk admin hvis e-posten ikke finnes. Minst 16 tegn. Ikke Demo1234!
# ADMIN_BOOTSTRAP_EMAIL="deg@ditt-domene.no"
# ADMIN_BOOTSTRAP_PASSWORD=""

# Offentlig kontaktside (valgfritt)
# CONTACT_EMAIL="deg@ditt-domene.no"
